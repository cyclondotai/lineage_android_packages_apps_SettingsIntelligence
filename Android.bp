package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "SettingsIntelligence-core",
    sdk_version: "system_current",
    srcs: [
        "src/**/*.java",
        "proto/**/*.proto",
    ],

    static_libs: [
        "androidx.legacy_legacy-support-v4",
        "androidx.legacy_legacy-support-v13",
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.legacy_legacy-preference-v14",
        "com.google.android.material_material",
        "SettingsLibActivityEmbedding",
        "dynamiccolors",
    ],
    proto: {
        type: "nano",
    },
}

// SettingsIntelligence's versionCode in a Cyclon image is the image's build time (vendor/cyclon's android/Core/cyclon.mk
// sets cyclon.fork_app_version_code), like Cyclon Core's and Dialer's: Core updates SettingsIntelligence from Cyclon's
// signed app feed between OS releases with a build coded just above the image's (CYC-2816), and every image built later
// replaces that update on its OTA. The manifest has no versionCode for aapt2 to keep.
soong_config_module_type {
    name: "cyclon_settingsintelligence_android_app",
    module_type: "android_app",
    config_namespace: "cyclon",
    value_variables: ["fork_app_version_code"],
    properties: ["aaptflags"],
}

cyclon_settingsintelligence_android_app {
    name: "SettingsIntelligence",
    soong_config_variables: {
        fork_app_version_code: {
            aaptflags: ["--version-code", "%s"],
            // A product without Cyclon's cyclon.mk: Soong's default, the platform SDK version.
            conditions_default: {
                aaptflags: ["--version-code", "37"],
            },
        },
    },
    optimize: {
        proguard_flags_files: ["proguard.cfg"],
    },
    sdk_version: "system_current",
    product_specific: true,
    privileged: true,
    required: ["privapp_whitelist_com.android.settings.intelligence"],

    static_libs: ["SettingsIntelligence-core"],
    resource_dirs: [],
}
