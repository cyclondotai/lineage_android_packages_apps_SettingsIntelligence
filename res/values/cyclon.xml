     Cyclon Glass, as on Settings' pages: Settings search floats over the launcher's ground (Android's wallpaper; the
     window items are on Theme.Settings), with the search field as a frosted pill and the results in one frosted card
     (the kit's .list), rows split by hairlines, ink titles and ink-3 summaries in Geist. Every colour, drawable and
     the font come from cyclon-shell-ui-glass (glass_*); the sizes here only place SettingsIntelligence's own views.
-->
<resources>
    <dimen name="cyclon_hairline">1dp</dimen>
    <!-- Inside the results card a row's words start 16dp in (glass_row_padding), 28dp from the screen's side with the
         card's 12dp (glass_list_margin), on the same edge as Settings' rows. -->
    <dimen name="cyclon_row_padding_horizontal">@dimen/glass_row_padding</dimen>
    <dimen name="cyclon_row_padding_vertical">15dp</dimen>
    <dimen name="cyclon_row_gap">16dp</dimen>
    <dimen name="cyclon_icon_size">20dp</dimen>
    <!-- The search pill and the results card sit 12dp in from the screen's sides (glass_list_margin), as Settings'
         cards and its search pill do. -->
    <dimen name="cyclon_search_margin">@dimen/glass_list_margin</dimen>

    <!-- A result's title (components.css .row .t1): Geist 17sp regular, tracked -0.01em, in ink. -->
    <style name="TextAppearance.CyclonSearchTitle" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">@font/glass_geist</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/glass_ink</item>
    </style>

    <!-- A result's summary (.row .t2): Geist 14sp regular in ink-3. -->
    <style name="TextAppearance.CyclonSearchSummary" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:fontFamily">@font/glass_geist</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/glass_ink_3</item>
    </style>

    <style name="TextAppearance.CyclonSearchBreadcrumb" parent="@style/TextAppearance.CyclonSearchSummary">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The query in the search pill: Geist 17sp in ink, the hint in ink-3 (Settings home's pill, .search .ph). -->
    <style name="TextAppearance.CyclonSearchQuery" parent="@android:style/TextAppearance.DeviceDefault.Medium">
        <item name="android:fontFamily">@font/glass_geist</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/glass_ink</item>
        <item name="android:textColorHint">@color/glass_ink_3</item>
    </style>

    <!-- The search field's theme: Material Components for the card, with Glass type and colours for the SearchView
         inside it (its query field takes textAppearanceMediumInverse, editTextColor and the theme's hint colour). The
         cursor and selection handles are ink (colorControlActivated), never the system accent. -->
    <style name="ThemeOverlay.CyclonSearchField" parent="@style/Theme.MaterialComponents.DayNight">
        <item name="android:fontFamily">@font/glass_geist</item>
        <item name="android:textAppearanceMediumInverse">@style/TextAppearance.CyclonSearchQuery</item>
        <item name="android:editTextColor">@color/glass_ink</item>
        <item name="android:textColorHint">@color/glass_ink_3</item>
        <item name="android:colorControlNormal">@color/glass_ink_3</item>
        <item name="android:colorControlActivated">@color/glass_ink</item>
        <item name="android:colorAccent">@color/glass_ink</item>
        <item name="colorPrimary">@color/glass_ink</item>
        <item name="colorSecondary">@color/glass_ink</item>
    </style>
</resources>
